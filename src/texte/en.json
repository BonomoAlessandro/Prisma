    "zumMenue": "Back to the menu",
    "kapitelKicker": "Chapter {n} · {titel}",
    "prolog": {
      "1": "High up in the mountains there is a little village. Smoke rises from the chimneys, and the stars twinkle above the roofs.",
      "2": "Every evening Noa climbs the hill behind the houses and looks for the North Star. It sits right at the end of the Little Dipper’s handle.",
      "3": "Tonight Noa has brought the flashlight along. Click. The North Star is going to get a signal.",
      "4": "But the light doesn’t get far. The stars of the Dipper are asleep, and without them it gets lost in the dark.",
      "5": "Then something blinks at the edge of the forest. A swarm of fireflies comes flying over and catches the light.",
      "6": "Each star in the Dipper belongs to a place and only wakes up when light gets there. Help the fireflies carry the light from place to place until it reaches the North Star."
    },
    "dorf": {
      "titel": "Village",
      "ueben": "Practice",
      "los": "Let’s go",
      "angebot": "The fireflies want to fly off to the forest right away. Would you like to practice with Noa in the village first?",
      "einstiegKicker": "Village · First Light",
      "einstieg": "Behind the house, Noa is practicing with the flashlight. With an old mirror and a piece of colored glass, you can send the light anywhere.",
      "ende": "Noa has the hang of it now. The fireflies are already waiting at the edge of the forest.",
      "fertig": "The village is glowing",
      "weiter": "Into the forest"
    },
    "kapitel": {
      "wald": {
        "titel": "The Forest",
        "reise": "The fireflies carry Noa’s light deep into the mountain forest. Somewhere above the fir trees, the first star is asleep.",
        "fertig": "The forest is glowing",
        "weiter": "On to the sea"
      },
      "meer": {
        "titel": "The Sea",
        "reise": "Above the forest, the first star has woken up. It points toward the sea, and the fireflies fly the light over the hills and down to the beach.",
        "fertig": "The sea is shining",
        "weiter": "On to the desert"
      },
      "wueste": {
        "titel": "The Desert",
        "reise": "Now the second star is shining too. The wind takes the light with it, far out across the water to where the desert begins.",
        "fertig": "The desert is glowing",
        "weiter": "On to the volcano"
      },
      "vulkan": {
        "titel": "The Volcano",
        "reise": "The third star twinkles over the dunes. A whirl of sand carries the light on to a crater with a fire burning inside.",
        "fertig": "The volcano is ablaze",
        "weiter": "Up into the sky"
      },
      "planeten": {
        "titel": "The Planets",
        "reise": "With the fourth star, the bowl of the Dipper is complete. Then the volcano erupts and flings the light high above the clouds.",
        "fertig": "The planets are shining",
        "weiter": "On to the stars"
      },
      "sterne": {
        "titel": "The Stars",
        "reise": "Five stars are already shining, and only one is still asleep. A comet takes the light along, far out to the stars.",
        "fertig": "The Dipper is awake",
        "weiter": "Look up"
      }
    },
    "finale": {
      "1": "The last star wakes up. Now the whole Little Dipper is shining.",
      "2": "The light travels along the handle all the way to the North Star.",
      "3": "The North Star has seen Noa’s signal."
    },
    "epilog": {
      "1": "That night Noa stays up on the hill for a long time, looking at the sky.",
      "2": "Then the North Star blinks. Once, twice, three times.",
      "3": "Noa laughs and blinks back with the flashlight. Above the village, all seven stars are shining now."
    }
  },
  "fuehrung": {
    "weiter": "Next",
    "schritt": {
      "erstesLicht": {
        "1": "Bring the light to the crystal. It goes straight ahead, and mirrors send it another way.",
        "2": "{Tippe} the mirror. It turns and sends the light on.",
        "3": "{Tippe} the mirror on the square base and see what happens.",
        "4": "Square bases stay put, round ones turn. {Drücke lang} this mirror to turn it back."
      },
      "brechung": {
        "1": "No light gets through a block. It swallows everything that hits it.",
        "2": "{Tippe} the mirror until the light reaches the prism.",
        "3": "A prism splits white light into red, green and blue.",
        "4": "{Tippe} the prism until each color hits the crystal of the same color."
      },
      "farbenlehre": {
        "1": "A filter only lets its own color through. Here the white light turns green.",
        "2": "The ring shows which color a crystal needs. A wrong color flickers in it.",
        "3": "{Tippe} the mirror until the green reaches the green crystal.",
        "4": "The other lamp shines red all by itself. {Tippe} its mirror until red reaches the red crystal."
      },
      "mischung": {
        "1": "This crystal needs magenta. You get it when red and blue hit it together.",
        "2": "{Tippe} the mirror until red and blue reach the crystal together.",
        "3": "The combiner mixes all the light that falls into it and sends it on as one beam.",
        "4": "{Tippe} the combiner until its magenta reaches the second crystal."
      }
    },
    "nebenbei": {
      "kamera": {
        "touch": "Swipe with one finger and the view turns. Use two fingers to zoom.",
        "maus": "Drag with the mouse and the view turns. Use the mouse wheel to zoom."
      },
      "neustart": {
        "touch": "Tap the circular arrow to start the lesson over.",
        "maus": "Click the circular arrow or press R to start the lesson over."
      }
    }
  },
