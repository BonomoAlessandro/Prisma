    "kapitelKicker": "Kapitel {n} · {titel}",
    "prolog": {
      "1": "Hoch in den Bergen liegt ein kleines Dorf. Aus den Kaminen steigt Rauch, und über den Dächern funkeln die Sterne.",
      "2": "Jeden Abend klettert Noa auf den Hügel hinter den Häusern und sucht den Polarstern. Er sitzt ganz vorn an der Deichsel des Kleinen Wagens.",
      "3": "Heute hat Noa die Taschenlampe mitgenommen. Klick. Der Polarstern soll ein Zeichen bekommen.",
      "4": "Aber das Licht kommt nicht weit. Die Sterne des Wagens schlafen, und ohne sie verliert es sich im Dunkeln.",
      "5": "Da blinkt etwas am Waldrand. Ein Schwarm Glühwürmchen fliegt heran und fängt das Licht ein.",
      "6": "Jeder Stern im Wagen gehört zu einem Ort und wacht erst auf, wenn dort Licht ankommt. Hilf den Glühwürmchen, das Licht von Ort zu Ort zu bringen, bis es beim Polarstern ankommt."
    },
    "dorf": {
      "titel": "Im Dorf",
      "ueben": "Üben",
      "los": "Gleich los",
      "angebot": "Die Glühwürmchen wollen gleich los in den Wald. Möchtest du vorher mit Noa im Dorf üben?",
      "einstiegKicker": "Im Dorf · Erstes Licht",
      "einstieg": "Hinter dem Haus übt Noa mit der Taschenlampe. Mit einem alten Spiegel und einem Stück buntem Glas lässt sich das Licht überallhin schicken.",
      "ende": "Jetzt hat Noa den Dreh raus. Am Waldrand warten schon die Glühwürmchen.",
      "fertig": "Das Dorf leuchtet",
      "weiter": "In den Bergwald"
    },
    "kapitel": {
      "wald": {
        "titel": "Der Bergwald",
        "reise": "Die Glühwürmchen fliegen mit Noas Licht tief in den Bergwald. Irgendwo über den Tannen schläft der erste Stern.",
        "fertig": "Der Wald leuchtet",
        "weiter": "Weiter zum Meer"
      },
      "meer": {
        "titel": "Das Meer",
        "reise": "Über dem Wald ist der erste Stern aufgewacht. Er zeigt zum Meer, und die Glühwürmchen fliegen mit dem Licht über die Hügel bis an den Strand.",
        "fertig": "Das Meer leuchtet",
        "weiter": "Weiter in die Wüste"
      },
      "wueste": {
        "titel": "Die Wüste",
        "reise": "Jetzt leuchtet auch der zweite Stern. Der Wind nimmt das Licht mit, weit übers Wasser bis dorthin, wo die Wüste anfängt.",
        "fertig": "Die Wüste leuchtet",
        "weiter": "Weiter zum Vulkan"
      },
      "vulkan": {
        "titel": "Der Vulkan",
        "reise": "Über den Dünen funkelt der dritte Stern. Ein Sandwirbel trägt das Licht weiter bis an einen Krater, in dem Feuer brennt.",
        "fertig": "Der Vulkan glüht",
        "weiter": "Hinauf in den Himmel"
      },
      "planeten": {
        "titel": "Die Planeten",
        "reise": "Mit dem vierten Stern ist die Schale des Wagens vollständig. Da bricht der Vulkan aus und schleudert das Licht hoch über die Wolken.",
        "fertig": "Die Planeten leuchten",
        "weiter": "Weiter zu den Sternen"
      },
      "sterne": {
        "titel": "Die Sterne",
        "reise": "Fünf Sterne leuchten schon, nur einer schläft noch. Ein Komet nimmt das Licht mit, weit hinaus zu den Sternen.",
        "fertig": "Der Wagen ist wach",
        "weiter": "Hinaufschauen"
      }
    },
    "finale": {
      "1": "Der letzte Stern wacht auf. Jetzt leuchtet der ganze Kleine Wagen.",
      "2": "Das Licht wandert die Deichsel entlang bis zum Polarstern.",
      "3": "Der Polarstern hat Noas Zeichen gesehen."
    },
    "epilog": {
      "1": "In dieser Nacht bleibt Noa noch lange auf dem Hügel sitzen und schaut hinauf.",
      "2": "Da blinkt der Polarstern. Einmal, zweimal, dreimal.",
      "3": "Noa lacht und blinkt mit der Taschenlampe zurück. Über dem Dorf leuchten jetzt alle sieben Sterne."
    }
  },
  "fuehrung": {
    "weiter": "Weiter",
    "schritt": {
      "erstesLicht": {
        "1": "Bring das Licht zum Kristall. Es läuft geradeaus, Spiegel lenken es um.",
        "2": "{Tippe} den Spiegel an. Er dreht sich und lenkt das Licht weiter.",
        "3": "{Tippe} den Spiegel auf dem eckigen Sockel an und schau, was passiert.",
        "4": "Eckige Sockel stehen fest, runde drehen sich. {Drücke lang} auf diesen Spiegel, dann dreht er zurück."
      },
      "brechung": {
        "1": "Durch einen Block kommt kein Licht. Er schluckt alles, was ihn trifft.",
        "2": "{Tippe} den Spiegel, bis das Licht beim Prisma ankommt.",
        "3": "Ein Prisma teilt weisses Licht in Rot, Grün und Blau.",
        "4": "{Tippe} das Prisma, bis jede Farbe den Kristall in ihrer Farbe trifft."
      },
      "farbenlehre": {
        "1": "Ein Filter lässt nur seine eigene Farbe durch. Aus dem weissen Licht wird hier Grün.",
        "2": "Am Ring siehst du, welche Farbe ein Kristall braucht. Eine falsche Farbe flackert darin.",
        "3": "{Tippe} den Spiegel, bis das Grün beim grünen Kristall ankommt.",
        "4": "Die andere Lampe leuchtet von selbst rot. {Tippe} ihren Spiegel, bis Rot beim roten Kristall ankommt."
      },
      "mischung": {
        "1": "Dieser Kristall braucht Magenta. Das entsteht, wenn Rot und Blau ihn zusammen treffen.",
        "2": "{Tippe} den Spiegel, bis Rot und Blau zusammen beim Kristall ankommen.",
        "3": "Der Kombinator mischt alles Licht, das hineinfällt, und schickt es als einen Strahl weiter.",
        "4": "{Tippe} den Kombinator, bis sein Magenta beim zweiten Kristall ankommt."
      }
    },
    "nebenbei": {
      "kamera": {
        "touch": "Wisch mit einem Finger, dann dreht sich die Ansicht. Mit zwei Fingern zoomst du.",
        "maus": "Zieh mit der Maus, dann dreht sich die Ansicht. Mit dem Mausrad zoomst du."
      },
      "neustart": {
        "touch": "Tippst du auf den Kreispfeil, fängt die Übung von vorn an.",
        "maus": "Klickst du auf den Kreispfeil oder drückst R, fängt die Übung von vorn an."
      }
    }
  },
